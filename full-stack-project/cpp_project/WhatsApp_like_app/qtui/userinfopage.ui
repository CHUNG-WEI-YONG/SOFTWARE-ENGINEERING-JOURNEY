  <property name="styleSheet">
   <string notr="true">/* 页面背景 */
QWidget#UserInfoPage {
    background-color: #f5f7fa;
}

/* 标题 */
QLabel#label {
    font-size: 18px;
    font-weight: bold;
    color: #1f2937;
    padding-bottom: 8px;
}

/* 字段名标签 */
QLabel#name_lb, QLabel#nick_lb, QLabel#label_4, QLabel#uid_lb {
    font-size: 13px;
    font-weight: 600;
    color: #4b5563;
}

/* 头像圆角 */
QLabel#head_lb {
    border-radius: 40px;
    border: 2px solid #e5e7eb;
    background-color: #e5e7eb;
}

/* 文本输入框 */
QTextEdit {
    font-size: 13px;
    color: #1f2937;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
}

/* 只读模式下的输入框变浅灰 */
QTextEdit:read-only {
    background-color: #f3f4f6;
    color: #6b7280;
    border: 1px solid #e5e7eb;
}

/* 获得焦点的输入框高亮蓝框 */
QTextEdit:focus {
    background-color: #ffffff;
    border: 1px solid #3b82f6;
}

/* Edit 按钮 */
QPushButton#pushButton, QPushButton#pushButton_2, QPushButton#pushButton_3 {
    background-color: #ffffff;
    color: #2563eb;
    border: 1px solid #bfdbfe;
    border-radius: 6px;
    font-size: 12px;
}
QPushButton#pushButton:hover, QPushButton#pushButton_2:hover, QPushButton#pushButton_3:hover {
    background-color: #eff6ff;
}
/* Edit 按钮激活状态 (按下时) */
QPushButton#pushButton:checked, QPushButton#pushButton_2:checked, QPushButton#pushButton_3:checked {
    background-color: #2563eb;
    color: #ffffff;
}

/* Upload 按钮 */
QPushButton#upload_btn {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#upload_btn:hover {
    background-color: #f9fafb;
}

/* Submit 提交按钮 */
QPushButton#pushButton_4 {
    background-color: #2563eb;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#pushButton_4:hover {
    background-color: #1d4ed8;
}
QPushButton#pushButton_4:disabled {
    background-color: #93c5fd;
    color: #ffffff;
}</string>
